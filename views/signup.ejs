<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up | Productivity App</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="auth-page">
    <section class="auth-card">
      <h1>Create account</h1>
      <p class="subtitle">Start organizing your day in minutes.</p>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="POST" action="/signup" class="form-stack">
        <label>
          Full name
          <input type="text" name="name" required value="<%= values.name || '' %>" />
        </label>

        <label>
          Email
          <input type="email" name="email" required value="<%= values.email || '' %>" />
        </label>

        <label>
          Password
          <input type="password" name="password" required minlength="6" />
        </label>

        <button type="submit">Create Account</button>
      </form>

      <p class="switch-link">Already have an account? <a href="/login">Log in</a></p>
    </section>
  </main>
</body>
</html>
